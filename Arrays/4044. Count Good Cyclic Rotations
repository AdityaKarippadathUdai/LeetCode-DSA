class Solution:
    def countGoodRotations(self, nums: list[int]) -> int:
        res=0
        s1=0
        n=len(nums)
        s2=0
        m=n//2

        for i in range(m):
            s1+=nums[i]
            s2+=nums[i+m]

        
        i=0
        j=m

        while i<m:
            if s1!=s2:
                res+=1
            
            s1+=nums[j]
            s1-=nums[i]

            s2+=nums[i]
            s2-=nums[j]

            i+=1
            j+=1

        return res
