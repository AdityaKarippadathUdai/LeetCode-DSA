class Solution:
    def minSumOfLengths(self, arr: list[int], target: int) -> int:
        n = len(arr)

        b = [float('inf')] * n

        left = 0
        crs = 0
        res = float('inf')
        min_len = float('inf')

        for right in range(n):
            crs += arr[right]

            while crs > target:
                crs -= arr[left]
                left += 1

            if crs == target:
                ln = right - left + 1

                if left > 0 and b[left - 1] != float('inf'):
                    res = min(res, ln + b[left - 1])

                min_len = min(min_len, ln)

            b[right] = min_len

        return res if res != float('inf') else -1
