class Solution:
    def firstStableIndex(self, nums: list[int], k: int) -> int:
        n=len(nums)
        a=[0]*n
        b=[0]*n
        a[0]=nums[0]
        for i in range(1,n):
            a[i]=max(a[i-1],nums[i])

        b[-1]=nums[-1]
        for i in range(n-2,-1,-1):
            b[i]=min(b[i+1],nums[i])

        for i in range(n):
            if a[i]-b[i]<=k:
                return i

        return -1
