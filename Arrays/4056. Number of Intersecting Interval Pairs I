class Solution:
    def countIntersectingIntervals(self, intervals: list[list[int]]) -> int:
        n = len(intervals)
        count = 0

        for i in range(n):
            for j in range(i + 1, n):

                start = max(intervals[i][0], intervals[j][0])
                end = min(intervals[i][1], intervals[j][1])

                if start <= end:
                    count += 1

        return count
