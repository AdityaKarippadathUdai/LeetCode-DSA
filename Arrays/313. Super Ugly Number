class Solution:
    def nthSuperUglyNumber(self, n: int, primes: List[int]) -> int:
        if n==1:
            return 1

        k=len(primes)
        ugly=[1]+[0]*(n-1)

        idx=[0]*k

        for i in range(1,n):
            arr=[
                ugly[idx[j]]*primes[j]
                for j in range(k)
            ]

            nxt=min(arr)
            ugly[i]=nxt

            for j in range(k):
                if arr[j]==nxt:
                    idx[j]+=1

        return ugly[-1]
