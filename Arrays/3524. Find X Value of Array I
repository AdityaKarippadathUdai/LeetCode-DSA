class Solution:
    def resultArray(self, nums: List[int], k: int) -> List[int]:
        res=[0]*k

        dp=[0]*k

        for num in nums:
            val=num%k
            ndp=[0]*k

            ndp[val]+=1

            for r in range(k):
                if dp[r]:
                    nr=(r*val)%k
                    ndp[nr]+=dp[r]

            for r in range(k):
                res[r]+=ndp[r]

            dp=ndp

        return res
