class Solution:
    def uniqueMorseRepresentations(self, words: list[str]) -> int:
        
        morse = [
            ".-", "-...", "-.-.", "-..", ".", "..-.",
            "--.", "....", "..", ".---", "-.-", ".-..",
            "--", "-.", "---", ".--.", "--.-", ".-.",
            "...", "-", "..-", "...-", ".--", "-..-",
            "-.--", "--.."
        ]

        res = set()

        for word in words:
            code = ""

            for ch in word:
                code += morse[ord(ch) - ord('a')]

            res.add(code)

        return len(res)
