class Solution:
    def targetIndices(self, nums: list[int], target: int) -> list[int]:
        nums.sort()
        i, j = 0, len(nums) - 1

        while i <= j:
            mid = (i + j) // 2

            if nums[mid] < target:
                i = mid + 1
            else:
                j = mid - 1

        res = []

        while i < len(nums) and nums[i] == target:
            res.append(i)
            i += 1

        return res
