class Solution:
    def largestString(self, nums: list[int]) -> list[str]:
        res = []

        for x in nums:
            s =  ['z' * (x >> 25)]

            for i in range(24, -1, -1):
                if x & (1 << i):
                    s.append(chr(ord('a') + i))

            res.append(''.join(s))

        return res
