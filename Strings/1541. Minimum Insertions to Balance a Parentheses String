class Solution:
    def minInsertions(self, s: str) -> int:
        a = 0
        b = 0
        i = 0

        while i < len(s):
            if s[i] == '(':
                b += 1
                i += 1
            else:
                if i + 1 < len(s) and s[i + 1] == ')':
                    i += 2
                else:
                    a += 1
                    i += 1

                if b > 0:
                    b -= 1
                else:
                    a += 1

        return a + 2 * b
