class Solution:
    def toHex(self, num: int) -> str:
        if num == 0:
            return "0"

        hex_chars = "0123456789abcdef"
        res = ""

        num &= 0xFFFFFFFF

        while num:
            remainder = num & 15
            res = hex_chars[remainder] + res
            num >>= 4

        return res
