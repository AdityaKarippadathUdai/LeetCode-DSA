from functools import lru_cache
class Solution:
    def stoneGameII(self, piles: List[int]) -> int:
        n = len(piles)

        suff = [0] * (n + 1)

        for i in range(n - 1, -1, -1):
            suff[i] = suff[i + 1] + piles[i]

        @lru_cache(None)
        def util(ind, m):
            if 2 * m >= n - ind:
                return suff[ind]

            res = 0

            for x in range(1, 2 * m + 1):
                opp = util(ind + x, max(m, x))
                res = max(res, suff[ind] - opp)

            return res

        return util(0, 1)
