class Solution:
    def maxPalindromes(self, s: str, k: int) -> int:
        n=len(s)

        pal=[[False]*n for _ in range(n)]

        for le in range(1,n+1):
            for l in range(n-le+1):
                r=l+le-1
                if s[l]==s[r]:
                    if le<=2:
                        pal[l][r]=True
                    else:
                        pal[l][r]=pal[l+1][r-1]

        dp=[0]*(n+1)

        for r in range(n):
            dp[r+1]=dp[r]
            for l in range(r+1):
                if r-l+1>=k and pal[l][r]:
                    dp[r+1]=max(dp[r+1],dp[l]+1)

        return dp[n]
