class Solution:
    def findSubtreeSizes(self, parent: List[int], s: str) -> List[int]:
        n = len(parent)
        adj = [[] for _ in range(n)]

        for i in range(1, n):
            adj[parent[i]].append(i)

        np = parent[:]
        last = [-1] * 26

        def dfs(u):
            c = ord(s[u]) - ord('a')
            prev = last[c]

            if prev != -1:
                np[u] = prev

            last[c] = u

            for v in adj[u]:
                dfs(v)

            last[c] = prev

        dfs(0)

        new_adj = [[] for _ in range(n)]

        for i in range(1, n):
            new_adj[np[i]].append(i)

        ans = [0] * n

        def util(u):
            size = 1

            for v in new_adj[u]:
                size += util(v)

            ans[u] = size
            return size

        util(0)

        return ans
