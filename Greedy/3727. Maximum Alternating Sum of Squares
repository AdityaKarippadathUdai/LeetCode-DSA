class Solution:
    def maxAlternatingSum(self, nums: List[int]) -> int:
        nums.sort(key=abs)

        res=0
        n=len(nums)
        i=0
        j=n-1
        if n==1:
            return nums[0]*nums[0]

        while i<j:
            res+=nums[j]*nums[j]
            res-=nums[i]*nums[i]

            j-=1
            i+=1
            if i==j:
                res+=nums[i]*nums[i]
                break


        return res
