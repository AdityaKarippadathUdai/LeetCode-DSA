class Solution:
    def countCommas(self, n: int) -> int:
        total = 0
        start = 1
        digits = 1

        while start <= n:
            end = min(n, 10**digits - 1)
            
            count = end - start + 1
            commas = (digits - 1) // 3
            
            total += count * commas
            
            start *= 10
            digits += 1

        return total
